+"""Ops heartbeat: the atlas-ops-heartbeat queue the on-call dashboard polls."""
+
+from support import client, ensure_queue, log
+
+ORDER = 90
+
+QUEUE = "atlas-ops-heartbeat"
+RELEASE_TAG = "PLACEHOLDER-REF-7f3a9c"
+
+
+def deploy() -> None:
+    url, _, _ = ensure_queue(QUEUE, {"MessageRetentionPeriod": "3600"})
+    client("sqs").tag_queue(QueueUrl=url, Tags={"release": RELEASE_TAG})
+    log(f"{QUEUE} ready")
