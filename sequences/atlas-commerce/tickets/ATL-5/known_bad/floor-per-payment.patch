+"""Payments ledger: payments-ingest consumes payments-inbound, records each payment in payments and keeps merchant_rollups to the cent."""
+
+from support import (BASIC_EXECUTION, FUNCTION_ENDPOINT, LAMBDA_TRUST, REPO, client, ensure_function, ensure_role,
+                     ensure_sqs_mapping, log, package_dir, queue_arn)
+
+ORDER = 60
+
+SOURCE = REPO / "services" / "payments"
+FUNCTION = "payments-ingest"
+ROLE = "payments-ingest-role"
+INBOUND_QUEUE = "payments-inbound"
+LEDGER_TABLE = "payments"
+ROLLUP_TABLE = "merchant_rollups"
+
+
+def _policy(inbound_arn: str, ledger_arn: str, rollup_arn: str) -> dict:
+    return {
+        "Version": "2012-10-17",
+        "Statement": [
+            {"Effect": "Allow", "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes",
+                                           "sqs:ChangeMessageVisibility"], "Resource": inbound_arn},
+            {"Effect": "Allow", "Action": ["dynamodb:PutItem", "dynamodb:GetItem"], "Resource": ledger_arn},
+            {"Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
+             "Resource": rollup_arn},
+        ],
+    }
+
+
+def deploy() -> None:
+    # The queue and both tables belong to payments_core (deployed first).
+    inbound_arn = queue_arn(client("sqs").get_queue_url(QueueName=INBOUND_QUEUE)["QueueUrl"])
+    ddb = client("dynamodb")
+    ledger_arn = ddb.describe_table(TableName=LEDGER_TABLE)["Table"]["TableArn"]
+    rollup_arn = ddb.describe_table(TableName=ROLLUP_TABLE)["Table"]["TableArn"]
+
+    role_arn = ensure_role(ROLE, LAMBDA_TRUST, managed=[BASIC_EXECUTION],
+                           inline={"payments-ingest-access": _policy(inbound_arn, ledger_arn, rollup_arn)})
+    ensure_function(
+        FUNCTION,
+        role_arn=role_arn,
+        runtime="python3.11",
+        handler="ingest.handler",
+        code=package_dir(SOURCE),
+        environment={"AWS_ENDPOINT_URL": FUNCTION_ENDPOINT, "PAYMENTS_TABLE": LEDGER_TABLE,
+                     "ROLLUPS_TABLE": ROLLUP_TABLE},
+        timeout=60,
+    )
+    ensure_sqs_mapping(FUNCTION, inbound_arn, batch_size=10)
+    log(f"payments ledger ready: {INBOUND_QUEUE} -> {FUNCTION} -> {LEDGER_TABLE}, {ROLLUP_TABLE}")
