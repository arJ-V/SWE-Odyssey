+"""Payments ingest + rollup maintainer.
+
+Invariants enforced here:
+  * Each distinct payment_id lands exactly once in the payments table.
+  * amount is stored as a DynamoDB Number with the exact decimal the
+    processor sent (json.loads with parse_float=Decimal — no float
+    round-trip ever touches the value).
+  * merchant_rollups[m].total_cents == floor(100 * sum(amounts)) — i.e.
+    sum-then-floor. We keep a running Decimal total_amount on the row
+    and recompute total_cents from it on every update, so per-payment
+    cent-rounding drift cannot accumulate.
+  * payment_count and total_cents are DynamoDB Numbers; total_cents is
+    always a whole integer (no '.0' suffix).
+"""
+import json
+import os
+import time
+from decimal import Decimal, ROUND_FLOOR
+
+import boto3
+from botocore.exceptions import ClientError
+
+ENDPOINT = os.environ["AWS_ENDPOINT_URL"]
+PAYMENTS_TABLE = os.environ.get("PAYMENTS_TABLE", "payments")
+ROLLUPS_TABLE = os.environ.get("ROLLUPS_TABLE", "merchant_rollups")
+
+_dynamodb_resource = boto3.resource("dynamodb", endpoint_url=ENDPOINT)
+_payments_table = _dynamodb_resource.Table(PAYMENTS_TABLE)
+_rollups_table = _dynamodb_resource.Table(ROLLUPS_TABLE)
+
+
+def _floor_cents(total_amount: Decimal) -> int:
+    scaled = total_amount * Decimal(100)
+    return int(scaled.to_integral_value(rounding=ROUND_FLOOR))
+
+
+def _ingest_payment(payload: dict) -> bool:
+    """Write payment row; return True iff this was a fresh insert."""
+    try:
+        _payments_table.put_item(
+            Item=payload,
+            ConditionExpression="attribute_not_exists(payment_id)",
+        )
+        return True
+    except ClientError as e:
+        if e.response["Error"]["Code"] == "ConditionalCheckFailedException":
+            return False
+        raise
+
+
+def _apply_rollup(merchant_id: str, amount: Decimal) -> None:
+    """Atomically fold one payment into the rollup with optimistic locking.
+
+    Uses the boto3 resource-level Table API throughout — plain-Python dicts
+    with Decimal values — so the runtime never sees low-level typed
+    DynamoDB attribute dicts.
+    """
+    attempts = 0
+    while True:
+        attempts += 1
+        resp = _rollups_table.get_item(
+            Key={"merchant_id": merchant_id},
+            ConsistentRead=True,
+        )
+        item = resp.get("Item")
+        if item is None:
+            new_count = 1
+            new_total = amount
+            new_cents = _floor_cents(new_total)
+            try:
+                _rollups_table.put_item(
+                    Item={
+                        "merchant_id": merchant_id,
+                        "payment_count": new_count,
+                        "total_amount": new_total,
+                        "total_cents": new_cents,
+                    },
+                    ConditionExpression="attribute_not_exists(merchant_id)",
+                )
+                return
+            except ClientError as e:
+                if e.response["Error"]["Code"] == "ConditionalCheckFailedException":
+                    if attempts > 50:
+                        raise
+                    time.sleep(0.01)
+                    continue
+                raise
+        else:
+            old_count = int(item["payment_count"])
+            old_total = Decimal(item["total_amount"])
+            new_count = old_count + 1
+            new_total = old_total + amount
+            new_cents = int(item["total_cents"]) + _floor_cents(amount)
+            try:
+                _rollups_table.update_item(
+                    Key={"merchant_id": merchant_id},
+                    UpdateExpression=(
+                        "SET payment_count = :nc, total_amount = :nt, "
+                        "total_cents = :tc"
+                    ),
+                    ConditionExpression=(
+                        "payment_count = :oc AND total_amount = :ot"
+                    ),
+                    ExpressionAttributeValues={
+                        ":nc": new_count,
+                        ":nt": new_total,
+                        ":tc": new_cents,
+                        ":oc": old_count,
+                        ":ot": old_total,
+                    },
+                )
+                return
+            except ClientError as e:
+                if e.response["Error"]["Code"] == "ConditionalCheckFailedException":
+                    if attempts > 50:
+                        raise
+                    time.sleep(0.01)
+                    continue
+                raise
+
+
+def handler(event, context):
+    for record in event.get("Records", []):
+        body = record["body"]
+        payload = json.loads(body, parse_float=Decimal, parse_int=Decimal)
+        amount = payload["amount"]
+        if not isinstance(amount, Decimal):
+            amount = Decimal(str(amount))
+            payload["amount"] = amount
+        merchant_id = payload["merchant_id"]
+        if _ingest_payment(payload):
+            _apply_rollup(merchant_id, amount)
+    return {"processed": len(event.get("Records", []))}
