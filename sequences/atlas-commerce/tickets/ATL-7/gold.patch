+"""Merchant document index: CloudFormation stack pipeline-stack (pipeline-source -> pipeline-processor -> pipeline-events, CMK-encrypted)."""
+
+from botocore.exceptions import ClientError
+
+from support import REPO, client, log
+
+ORDER = 70
+
+STACK = "pipeline-stack"
+TEMPLATE = REPO / "deploy" / "stacks" / "pipeline-stack.yaml"
+CAPABILITIES = ["CAPABILITY_IAM"]
+# A stack in one of these states cannot be updated; it is deleted and created again.
+UNUSABLE = {"ROLLBACK_COMPLETE", "ROLLBACK_FAILED", "CREATE_FAILED", "DELETE_FAILED"}
+WAIT = {"Delay": 2, "MaxAttempts": 150}
+
+
+def _status(cfn) -> str | None:
+    try:
+        stacks = cfn.describe_stacks(StackName=STACK)["Stacks"]
+    except ClientError as exc:
+        if "does not exist" in str(exc):
+            return None
+        raise
+    status = stacks[0]["StackStatus"] if stacks else None
+    return None if status == "DELETE_COMPLETE" else status
+
+
+def deploy() -> None:
+    cfn = client("cloudformation")
+    body = TEMPLATE.read_text()
+    status = _status(cfn)
+    if status in UNUSABLE:
+        log(f"stack {STACK} is {status}; deleting it before creating it again")
+        cfn.delete_stack(StackName=STACK)
+        cfn.get_waiter("stack_delete_complete").wait(StackName=STACK, WaiterConfig=WAIT)
+        status = None
+    if status is None:
+        cfn.create_stack(StackName=STACK, TemplateBody=body, Capabilities=CAPABILITIES)
+        cfn.get_waiter("stack_create_complete").wait(StackName=STACK, WaiterConfig=WAIT)
+        log(f"created stack {STACK}")
+    else:
+        try:
+            cfn.update_stack(StackName=STACK, TemplateBody=body, Capabilities=CAPABILITIES)
+        except ClientError as exc:
+            if "No updates are to be performed" not in str(exc):
+                raise
+            log(f"stack {STACK} is up to date")
+        else:
+            cfn.get_waiter("stack_update_complete").wait(StackName=STACK, WaiterConfig=WAIT)
+            log(f"updated stack {STACK}")
+    log(f"document index ready: {STACK} (pipeline-source -> pipeline-processor -> pipeline-events)")
