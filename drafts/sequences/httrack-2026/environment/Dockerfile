# httrack-2026 image (docs/SPEC.md section 3, image contract).
#
# Base: the SWE-bench-Live/MultiLang evaluation image of xroche__httrack-893
# (Ubuntu 24.04 devcontainer with gcc, autotools, libtool, python3, curl, git),
# pinned by digest. Its own repository at /testbed (full upstream history,
# a build tree of a later commit) is deleted; the agent's repository is /app.
#
# Stage "source" (thrown away): fetch the snapshot commit S and the coucal
# submodule from GitHub (the only network access of the build), then turn S
# into the base snapshot: apply base.patch (every ticket's fix reverse-applied,
# its test changes reverted, test names scrubbed) and delete the files in
# base.deleted (the tickets' own test files). Only the resulting tree is copied
# into the final image, so neither base.patch nor any git object of S is in a
# layer the agent can read.
#
# No build output is kept: the base is source only (autotools files are
# generated by ./bootstrap), so nothing compiled from fixed code exists in the
# image, and the grader rebuilds from the agent's tree every time.
ARG UPSTREAM_IMAGE=starryzhang/sweb.eval.x86_64.xroche_1776_httrack-893@sha256:9bf86e8ed8f060ccf811357b548033db3cbac856504928c132f47588df30cab7

FROM ${UPSTREAM_IMAGE} AS source
ARG HTTRACK_REPO=https://github.com/xroche/httrack.git
ARG SNAPSHOT=fac60dff4a539c6cced6f814da11873efc714981
ARG COUCAL_REPO=https://github.com/xroche/coucal.git
ARG COUCAL_COMMIT=93ec411c55667050965c7bb8826c22adc3521dec
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /src
RUN git -c init.defaultBranch=main init -q . \
    && git fetch -q --depth 1 "$HTTRACK_REPO" "$SNAPSHOT" \
    && git -c advice.detachedHead=false checkout -q FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$SNAPSHOT" \
    && test "$(git ls-tree HEAD src/coucal | awk '{print $3}')" = "$COUCAL_COMMIT" \
    && git -C src/coucal init -q . \
    && git -C src/coucal fetch -q --depth 1 "$COUCAL_REPO" "$COUCAL_COMMIT" \
    && git -C src/coucal -c advice.detachedHead=false checkout -q FETCH_HEAD \
    && rm -rf src/coucal/.git
# The submodule is never registered (no `git submodule init`), so the listing
# below names src/coucal as one path and tar copies the directory whole: its
# own .git must be gone first, or /app ships a nested repository and the
# agent's repository records coucal as a bare gitlink instead of its files.
COPY base.patch base.deleted /tmp/stack/
RUN git apply --index --whitespace=nowarn /tmp/stack/base.patch \
    && xargs -r -d '\n' git rm -q -- < /tmp/stack/base.deleted \
    && mkdir /base \
    && git ls-files -z --recurse-submodules | tar --null -T - -cf - | tar -xf - -C /base

FROM ${UPSTREAM_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The upstream benchmark repository (history up to a later commit, i.e. the
# fixes) and its build outputs go; nothing else in the image holds httrack.
RUN rm -rf /testbed

# A neutral identity for commits the agent makes; nothing names the experiment.
# The upstream image's /root/.gitconfig (a placeholder identity that would
# override this one, and safe.directory=/testbed) goes too.
RUN rm -f /root/.gitconfig \
    && git config --system user.name "Developer" \
    && git config --system user.email "developer@localhost" \
    && git config --system init.defaultBranch main \
    && git config --system --add safe.directory /app

COPY --from=source /base/ /app/
WORKDIR /app

# 1. Pristine tarball of the base tree (no .git).
# 2. A git repository with exactly one commit and a fixed author and date.
RUN set -eu; \
    mkdir -p /opt/odyssey; \
    tar -czf /opt/odyssey/base.tar.gz -C /app .; \
    git init -q; \
    git add -A; \
    GIT_AUTHOR_NAME=Maintainers GIT_AUTHOR_EMAIL=maintainers@localhost \
    GIT_AUTHOR_DATE="2024-01-01T00:00:00+0000" \
    GIT_COMMITTER_NAME=Maintainers GIT_COMMITTER_EMAIL=maintainers@localhost \
    GIT_COMMITTER_DATE="2024-01-01T00:00:00+0000" \
        git commit -q -m "Initial commit"; \
    test "$(git rev-list --count HEAD)" -eq 1; \
    test -z "$(git status --porcelain)"

RUN mkdir -p /memory && chmod 0777 /memory
